{
  "_comment": "Spark X2.5 4B on v5 data, bf16 LoRA (the champion's method). QLoRA is impossible: Spark's custom code multiplies weight matrices directly, which fails on bitsandbytes 4-bit weights. transformers 4.57.1 via .spark-libs.",
  "base_model": "XHToken/Spark-X2.5-4B",
  "hf_tokenizer": "XHToken/Spark-X2.5-4B",
  "ollama_template_from": "hf.co/XHToken/Spark-X2.5-4B-GGUF:Q4_K_M",
  "instruction_part": "<|User|>",
  "response_part": "<|Bot|>",
  "max_seq_len": 4608,
  "lora_r": 16,
  "lora_alpha": 16,
  "epochs": 2,
  "lr": 0.0002,
  "batch_size": 1,
  "grad_accum": 16,
  "seed": 3407,
  "train": "data/generated/train-v5.jsonl",
  "val": "data/generated/val-v3.jsonl",
  "out": "outputs/spark-x25-4b-lora-v5",
  "backend": "hf",
  "end_part": "<\uff5cend\u2581of\u2581sentence\uff5c>",
  "target_modules": [
    "q_k_v_proj",
    "out_proj",
    "g_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ],
  "load_in_4bit": false,
  "pythonpath": ".spark-libs",
  "hf_cache": "/ai/models/homeai/hf-cache",
  "labelled_logits_only": true
}
