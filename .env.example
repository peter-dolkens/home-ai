# Copy to .env and fill in. The bridge CLI reads .env from the project root.
# Home Assistant host (the bridge connects to https://$HA_HOSTNAME), or set HA_URL for a full URL.
HA_HOSTNAME=homeassistant.example
# HA_URL=http://homeassistant.local:8123

# Auth: a long-lived access token, or a username and password.
HA_TOKEN=
# HA_USERNAME=
# HA_PASSWORD=
